# Runtime template only. Do not put real keys into this tracked file.
DEVICE_SECRET=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Google TTS uses the attached Cloud Run identity, not an API key or JSON key file.
TTS_PROVIDER=google
GOOGLE_CLOUD_PROJECT=m5stack-515405
# Optional legacy alternative, only when TTS_PROVIDER=azure:
AZURE_SPEECH_KEY=
AZURE_REGION=
TAVILY_API_KEY=
# Select a currently available model and explicitly allow it on the server.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
ALLOWED_MODELS=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1200
# Required before enabling direct device access; Firestore counter state contains no conversations.
DURABLE_QUOTAS_REQUIRED=true
# Approve only after verifying the whole STT/LLM/search/TTS chain's data-use terms.
PRIVATE_PROVIDERS_APPROVED=false
# Enable only after accepting the search provider's query-data use terms.
PRIVATE_SEARCH_APPROVED=false
REQUIRE_ZDR=true
TTS_VOICE=he-IL-HilaNeural
REQUESTS_PER_MINUTE=6
REQUESTS_PER_DAY=100
TURN_TIMEOUT_SECONDS=45
